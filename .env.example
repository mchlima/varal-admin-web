# Variáveis do varal-admin-web. Copie para `.env.local` (fora do git) ou deixe
# que `scripts/worktree.sh new` gere o arquivo do worktree (RN-01.07).
# Nunca coloque segredos aqui: o admin é um app estático e tudo o que entra no
# build fica visível no navegador.

# Identificação do worktree (gerado por scripts/worktree.sh).
WORKTREE_SLUG=main

# Deslocamento de portas (RN-01.08): 0 no checkout principal, 1 a 99 nos worktrees.
PORT_OFFSET=0

# Porta do servidor de desenvolvimento: 3200 + PORT_OFFSET.
PORT=3200

# URL da API usada pelo cliente HTTP. Fica fixa no build (`pnpm generate`).
# Desenvolvimento: API do checkout principal; para testar contra a API de uma
# branch, use http://localhost:<3000 + PORT_OFFSET da API>.
# Produção: https://api-web-varal.kratinho.com.br
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Origem do openapi.json usada por `pnpm gen:api` (opcional). Caminho de
# arquivo ou URL. Padrão: ../varal-web-api/openapi.json ao lado do checkout
# principal.
# OPENAPI_SOURCE=
